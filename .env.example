# ==============================================================================
# SoftTech Solutions (STS) Legacy CMS - Environment Variables Configuration Template
# ==============================================================================

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/softechsol_db?schema=public"

# App Environment
NODE_ENV="development"
APP_URL="http://localhost:3000"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-generated-super-secret-jwt-key-min-32-chars"

# File Storage
STORAGE_BASE_PATH=""
STORAGE_URL_PREFIX="/storage"

# Optional Cloudinary (if enabled)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
